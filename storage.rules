rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    function validVideo() {
      return request.resource.size < 200 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if owner(userId) && validImage();
      allow delete: if owner(userId) && signedIn();
    }

    match /posts/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(userId) && validImage();
    }

    match /videos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if owner(userId) && validVideo();
      allow delete: if owner(userId) && signedIn();
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(userId) && validImage();
    }

    match /messages/{chatId}/{allPaths=**} {
      allow read, write: if signedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    match /products/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(userId) && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}