rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    function validVideo() {
      return request.resource.size < 200 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }
    function isFriend(uid) {
      return signedIn() && (
        firestore.exists(/databases/(default)/documents/friends/$(request.auth.uid + '_' + uid)) ||
        firestore.exists(/databases/(default)/documents/friends/$(uid + '_' + request.auth.uid))
      );
    }
    function canReadPost(postId, ownerId) {
      let post = firestore.get(/databases/(default)/documents/posts/$(postId)).data;
      return signedIn() && (
        post.ownerId == request.auth.uid ||
        post.privacy == 'public' ||
        (post.privacy == 'friends' && isFriend(ownerId))
      );
    }
    function canReadStory(storyId, ownerId) {
      let story = firestore.get(/databases/(default)/documents/stories/$(storyId)).data;
      return signedIn() && (
        story.ownerId == request.auth.uid ||
        story.privacy == 'public' ||
        (story.privacy == 'friends' && isFriend(ownerId))
      );
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if owner(userId) && validImage();
      allow delete: if owner(userId) && signedIn();
    }

    match /posts/{userId}/{postId}/{allPaths=**} {
      allow read: if canReadPost(postId, userId);
      allow create, update: if owner(userId) && validImage();
      allow delete: if owner(userId) && signedIn();
    }

    match /videos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if owner(userId) && validVideo();
      allow delete: if owner(userId) && signedIn();
    }

    match /stories/{userId}/{storyId}/{allPaths=**} {
      allow read: if canReadStory(storyId, userId);
      allow create, update: if owner(userId) && validImage();
      allow delete: if owner(userId) && signedIn();
    }

    match /messages/{chatId}/{allPaths=**} {
      allow read, write: if signedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    match /products/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(userId) && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}