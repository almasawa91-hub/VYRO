rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function chatMember(chatId) {
      return signedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(uid);
    }
    match /posts/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(uid);
    }
    match /videos/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(uid);
    }
    match /stories/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(uid);
    }
    match /products/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if owner(uid);
    }
    match /messages/{chatId}/{allPaths=**} {
      allow read, write: if chatMember(chatId);
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
